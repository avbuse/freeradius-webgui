FLASK_SECRET_KEY=change-me
AUTH_MODE=local
LOCAL_AUTH_FALLBACK=true
DASHBOARD_USER=admin
# Use either a plain passkey or a werkzeug password hash.
DASHBOARD_PASSKEY=change-me
# DASHBOARD_PASSKEY_HASH=pbkdf2:sha256:...
RBAC_DB_PATH=/opt/freeradius-webgui/data/rbac.db
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
ENTRA_SCOPES=openid profile email
ENTRA_GROUP_CLAIM=groups
FREERADIUS_SERVICE=freeradius
VALIDATE_COMMAND=freeradius -XC
TRUSTED_ROOT_UPDATE_COMMAND=update-ca-certificates
FREERADIUS_CONFIG_ROOT=/etc/freeradius/3.0
AUTO_DISCOVER_CONFIGS=true
SERVER_CERT_PATH=/etc/freeradius/3.0/certs/server.pem
SERVER_KEY_PATH=/etc/freeradius/3.0/certs/server.key
SERVER_CSR_PATH=/etc/freeradius/3.0/certs/server.csr
TRUSTED_ROOT_DIR=/usr/local/share/ca-certificates
# Key:value pairs of editable config files
# Entries here are always included. With AUTO_DISCOVER_CONFIGS=true, common configs under
# FREERADIUS_CONFIG_ROOT are also added automatically.
# Example: default:/etc/freeradius/3.0/sites-enabled/default,eap:/etc/freeradius/3.0/mods-enabled/eap
EDITABLE_CONFIGS=default:/etc/freeradius/3.0/sites-enabled/default,eap:/etc/freeradius/3.0/mods-enabled/eap
